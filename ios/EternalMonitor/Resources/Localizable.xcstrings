    "Paused. Tap Connect USB to use the cable again." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "متوقف مؤقتًا. اضغط اتصال USB لاستخدام الكابل مرة أخرى."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pausiert. Tippe auf „USB verbinden“, um das Kabel wieder zu nutzen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Paused. Tap Connect USB to use the cable again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En pausa. Toca Conectar USB para volver a usar el cable."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En pause. Touchez Connecter en USB pour réutiliser le câble."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "रुका हुआ है। केबल फिर से इस्तेमाल करने के लिए USB कनेक्ट करें पर टैप करें।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一時停止中です。ケーブルをもう一度使うには「USB で接続」をタップしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "일시 정지됨. 케이블을 다시 사용하려면 USB 연결을 탭하세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pausado. Toque em Conectar USB para usar o cabo de novo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Пауза. Нажмите «Подключить USB», чтобы снова использовать кабель."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已暂停。轻点“连接 USB”以再次使用线缆。"
          }
        }
      }
    },
