	; *** Inno Setup version 5.5.3+ Hindi messages ***
; Translated by Him Prasad Gautam [ drishtibachak at gmail.com ]
; EternalMonitor corrected the messages its installer shows (spelling, wording,
; "PC" for computer) against Inno Setup 6.7.3's Default.isl.
; To download user-contributed translations of this file, go to:
; http://www.jrsoftware.org/files/istrans/
;
; Note: When translating this text, do not add periods (.) to the end of
; messages that didn't have them already, because on those messages Inno
; Setup adds the periods automatically (appending a period would result in
; two periods being displayed).

[LangOptions]
; The following three entries are very important. Be sure to read and 
; understand the '[LangOptions] section' topic in the help file.
LanguageName=<0939><093F><0928><094D><0926><0940>
LanguageID=$0439
LanguageCodePage=0
; If the language you are translating to requires special font faces or
; sizes, uncomment any of the following entries and change them accordingly.
;DialogFontName=
;DialogFontSize=10
;WelcomeFontName=
WelcomeFontSize=12
;TitleFontName=
TitleFontSize=35
;CopyrightFontName=
CopyrightFontSize=9

[Messages]

